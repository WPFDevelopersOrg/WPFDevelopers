<UserControl
    x:Class="WPFDevelopers.Samples.ExampleViews.TimelineExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WPFDevelopers.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFDevelopers.Samples.ExampleViews"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:WPFDevelopers.Samples.ViewModels"
    xmlns:wd="https://github.com/WPFDevelopersOrg/WPFDevelopers"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    mc:Ignorable="d">
    <controls:CodeViewer Header="{Binding NavigateMenuItem.DisplayName}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12" wd:PanelHelper.Spacing="12">
                <GroupBox Header="Vertical / Start">
                    <wd:Timeline Margin="16">
                        <wd:TimelineItem Content="Create a service site" />
                        <wd:TimelineItem Content="Solve initial network problems" DotBrush="{DynamicResource WD.SuccessBrush}" />
                        <wd:TimelineItem DotBrush="{DynamicResource WD.DangerBrush}">
                            <StackPanel>
                                <TextBlock Text="Technical testing" />
                                <TextBlock Foreground="{DynamicResource WD.RegularTextBrush}" Text="Multiline content keeps the nodes aligned." />
                            </StackPanel>
                        </wd:TimelineItem>
                        <wd:TimelineItem Content="Network problems being solved" IsLoading="True" />
                    </wd:Timeline>
                </GroupBox>
                <GroupBox Header="Horizontal / Alternate / Labels">
                    <wd:Timeline
                        MinHeight="150"
                        Margin="16"
                        Mode="Alternate"
                        Orientation="Horizontal">
                        <wd:TimelineItem Content="Create" Label="09:00" />
                        <wd:TimelineItem
                            Content="Develop"
                            DotBrush="{DynamicResource WD.SuccessBrush}"
                            Label="10:00" />
                        <wd:TimelineItem Content="Test" Label="11:00">
                            <wd:TimelineItem.Dot>
                                <TextBlock FontSize="18" Text="!" />
                            </wd:TimelineItem.Dot>
                        </wd:TimelineItem>
                        <wd:TimelineItem
                            Content="Deploy"
                            IsLoading="True"
                            Label="12:00" />
                    </wd:Timeline>
                </GroupBox>
                <TabControl>
                    <TabItem Header="C# + XAML / Events">
                        <StackPanel Margin="16" wd:PanelHelper.Spacing="12">
                            <WrapPanel wd:PanelHelper.Spacing="4">
                                <TextBlock VerticalAlignment="Center" Text="Orientation" />
                                <ComboBox
                                    Width="120"
                                    ItemsSource="{Binding Orientations, RelativeSource={RelativeSource AncestorType={x:Type local:TimelineExample}}}"
                                    SelectedItem="{Binding Orientation, ElementName=CodeTimeline}" />
                                <TextBlock VerticalAlignment="Center" Text="Mode" />
                                <ComboBox
                                    Width="120"
                                    ItemsSource="{Binding Modes, RelativeSource={RelativeSource AncestorType={x:Type local:TimelineExample}}}"
                                    SelectedItem="{Binding Mode, ElementName=CodeTimeline}" />
                                <CheckBox
                                    VerticalAlignment="Center"
                                    Content="Reverse"
                                    IsChecked="{Binding Reverse, ElementName=CodeTimeline}" />
                                <Button
                                    Click="Add_Click"
                                    Content="Add"
                                    Style="{StaticResource WD.PrimaryButton}" />
                                <Button Click="Remove_Click" Content="Remove last" />
                                <Button Click="Complete_Click" Content="Complete pending" />
                                <Button Click="Next_Click" Content="Next step" ToolTip="Complete all existing nodes and append a loading node." />
                                <Button Click="Reset_Click" Content="Reset" />
                            </WrapPanel>
                            <wd:Timeline
                                x:Name="CodeTimeline"
                                MinHeight="180"
                                MaxHeight="360"
                                ItemsSource="{Binding CodeEvents, RelativeSource={RelativeSource AncestorType={x:Type local:TimelineExample}}}"
                                Mode="Alternate">
                                <wd:Timeline.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource WD.TimelineItem}" TargetType="{x:Type wd:TimelineItem}">
                                        <Setter Property="Label" Value="{Binding Time}" />
                                        <Setter Property="DotBrush" Value="{Binding Brush}" />
                                        <Setter Property="IsLoading" Value="{Binding IsLoading}" />
                                    </Style>
                                </wd:Timeline.ItemContainerStyle>
                                <wd:Timeline.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Title}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Foreground="{DynamicResource WD.RegularTextBrush}"
                                                Text="{Binding Description}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </wd:Timeline.ItemTemplate>
                            </wd:Timeline>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="MVVM / Commands">
                        <TabItem.DataContext>
                            <vm:TimelineExampleVM />
                        </TabItem.DataContext>
                        <StackPanel Margin="16" wd:PanelHelper.Spacing="12">
                            <WrapPanel wd:PanelHelper.Spacing="4">
                                <TextBlock VerticalAlignment="Center" Text="Orientation" />
                                <ComboBox
                                    Width="120"
                                    ItemsSource="{Binding Orientations}"
                                    SelectedItem="{Binding Orientation, Mode=TwoWay}" />
                                <TextBlock VerticalAlignment="Center" Text="Mode" />
                                <ComboBox
                                    Width="120"
                                    ItemsSource="{Binding Modes}"
                                    SelectedItem="{Binding Mode, Mode=TwoWay}" />
                                <CheckBox
                                    VerticalAlignment="Center"
                                    Content="Reverse"
                                    IsChecked="{Binding Reverse, Mode=TwoWay}" />
                                <Button
                                    Command="{Binding AddCommand}"
                                    Content="Add"
                                    Style="{StaticResource WD.PrimaryButton}" />
                                <Button Command="{Binding RemoveCommand}" Content="Remove last" />
                                <Button Command="{Binding CompleteCommand}" Content="Complete pending" />
                                <Button Command="{Binding NextCommand}" Content="Next step" ToolTip="Complete all existing nodes and append a loading node." />
                                <Button Command="{Binding ResetCommand}" Content="Reset" />
                            </WrapPanel>
                            <wd:Timeline
                                x:Name="InteractiveTimeline"
                                MinHeight="180"
                                MaxHeight="360"
                                ItemsSource="{Binding Events}"
                                Mode="{Binding Mode}"
                                Orientation="{Binding Orientation}"
                                Reverse="{Binding Reverse}">
                                <wd:Timeline.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource WD.TimelineItem}" TargetType="{x:Type wd:TimelineItem}">
                                        <Setter Property="Label" Value="{Binding Time}" />
                                        <Setter Property="DotBrush" Value="{Binding Brush}" />
                                        <Setter Property="IsLoading" Value="{Binding IsLoading}" />
                                    </Style>
                                </wd:Timeline.ItemContainerStyle>
                                <wd:Timeline.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Title}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Foreground="{DynamicResource WD.RegularTextBrush}"
                                                Text="{Binding Description}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </wd:Timeline.ItemTemplate>
                            </wd:Timeline>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
        <controls:CodeViewer.SourceCodes>
            <controls:SourceCodeModel CodeSource="/WPFDevelopers.SamplesCode;component/ExampleViews/TimelineExample.xaml" CodeType="Xaml" />
            <controls:SourceCodeModel CodeSource="/WPFDevelopers.SamplesCode;component/ExampleViews/TimelineExample.xaml.cs" CodeType="CSharp" />
            <controls:SourceCodeModel
                CodeSource="/WPFDevelopers.SamplesCode;component/ViewModels/TimelineExampleVM.cs"
                CodeType="CSharp"
                Haader="TimelineExampleVM.cs" />
        </controls:CodeViewer.SourceCodes>
    </controls:CodeViewer>
</UserControl>
