<UserControl
    x:Class="WPFDevelopers.Samples.ExampleViews.Basics.ThemeExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WPFDevelopers.Samples.Controls"
    xmlns:wd="https://github.com/WPFDevelopersOrg/WPFDevelopers"
    Background="{DynamicResource WD.BackgroundBrush}">
    <controls:CodeViewer Header="Theme">
        <ScrollViewer>
            <StackPanel Margin="20,10">
                <WrapPanel Margin="0,10">
                    <Image
                        Width="100"
                        Height="100"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="/WPFDevelopers.Samples;component/WPFDevelopers.ico" />
                    <StackPanel Margin="10,0">
                        <TextBlock
                            Padding="0,4"
                            HorizontalAlignment="Center"
                            FontSize="20"
                            Foreground="{DynamicResource WD.PrimaryBrush}"
                            Text="WPFDevelopers" />
                        <TextBlock
                            Padding="0,4"
                            HorizontalAlignment="Center"
                            FontSize="20"
                            Foreground="{DynamicResource WD.PrimaryBrush}"
                            Text="微信号公众号:WPFDevelopers" />
                        <TextBlock
                            Padding="0,10"
                            FontSize="20"
                            Foreground="{DynamicResource WD.PrimaryBrush}">
                            <Hyperlink NavigateUri="https://github.com/WPFDevelopersOrg/WPFDevelopers" RequestNavigate="GithubHyperlink_RequestNavigate">Github 源码</Hyperlink>
                            <Run />
                            <Run />
                            <Run />
                            <Hyperlink NavigateUri="https://gitee.com/WPFDevelopersOrg/WPFDevelopers" RequestNavigate="GiteeHyperlink_RequestNavigate">码云源码</Hyperlink>
                            <Run />
                            <Run />
                            <Run />
                            <Hyperlink NavigateUri="https://gitee.com/WPFDevelopersOrg/WPFDevelopers" RequestNavigate="QQHyperlink_RequestNavigate">加入QQ群：458041663</Hyperlink>
                            <Hyperlink>、340500857、929469013</Hyperlink>
                        </TextBlock>
                    </StackPanel>

                </WrapPanel>
                <TextBlock
                    Margin="0,20,0,0"
                    FontSize="20"
                    Text="Theme" />
                <controls:Theme Margin="0,10" />
                <TextBlock
                    Margin="0,20,0,0"
                    FontSize="20"
                    Text="Light | Dark" />
                <WrapPanel Margin="10">
                    <wd:Segmented
                        x:Name="PART_Segmented"
                        Width="100"
                        wd:ElementHelper.CornerRadius="14"
                        ItemClick="Segmented_ItemClick">
                        <wd:SegmentedItem x:Name="SegmentedLight">
                            <wd:PathIcon
                                Width="18"
                                Height="18"
                                Data="M12 19a7 7 0 1 1 0-14 7 7 0 0 1 0 14Zm0-1.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 1 0 0 11Zm-5.657.157a.75.75 0 0 1 0 1.06l-1.768 1.768a.749.749 0 0 1-1.275-.326.749.749 0 0 1 .215-.734l1.767-1.768a.75.75 0 0 1 1.061 0ZM3.515 3.515a.75.75 0 0 1 1.06 0l1.768 1.768a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215L3.515 4.575a.75.75 0 0 1 0-1.06ZM12 0a.75.75 0 0 1 .75.75v2.5a.75.75 0 0 1-1.5 0V.75A.75.75 0 0 1 12 0ZM4 12a.75.75 0 0 1-.75.75H.75a.75.75 0 0 1 0-1.5h2.5A.75.75 0 0 1 4 12Zm8 8a.75.75 0 0 1 .75.75v2.5a.75.75 0 0 1-1.5 0v-2.5A.75.75 0 0 1 12 20Zm12-8a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h2.5A.75.75 0 0 1 24 12Zm-6.343 5.657a.75.75 0 0 1 1.06 0l1.768 1.768a.751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018l-1.768-1.767a.75.75 0 0 1 0-1.061Zm2.828-14.142a.75.75 0 0 1 0 1.06l-1.768 1.768a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042l1.767-1.768a.75.75 0 0 1 1.061 0Z"
                                Foreground="{DynamicResource WD.PrimaryTextBrush}" />
                        </wd:SegmentedItem>
                        <wd:SegmentedItem x:Name="SegmentedDark">
                            <Border
                                Width="18"
                                Height="18"
                                Background="{DynamicResource WD.BackgroundBrush}"
                                CornerRadius="10">
                                <wd:PathIcon
                                    Width="16"
                                    Height="16"
                                    Data="M12 2a10 10 0 1 0 10 10A7 7 0 0 1 12 2Z"
                                    Foreground="{DynamicResource WD.PrimaryTextBrush}" />
                            </Border>
                        </wd:SegmentedItem>
                    </wd:Segmented>
                </WrapPanel>
                <TextBlock
                    Margin="0,20,0,0"
                    FontSize="20"
                    Text="Languages" />
                <WrapPanel Margin="10" wd:PanelHelper.Spacing="4">
                    <TextBlock VerticalAlignment="Center" Text="Languages:" />
                    <ComboBox
                        SelectedIndex="0"
                        SelectionChanged="ComboBoxLanguages_SelectionChanged"
                        ToolTip="目前翻译只是针对WD的自定义控件进行了多语言翻译">
                        <ComboBoxItem Tag="zh-cn">中文</ComboBoxItem>
                        <ComboBoxItem Tag="en-US">English</ComboBoxItem>
                        <ComboBoxItem Tag="ko-KR">한국어</ComboBoxItem>
                    </ComboBox>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
        <controls:CodeViewer.SourceCodes>
            <controls:SourceCodeModel CodeSource="/WPFDevelopers.SamplesCode;component/ExampleViews/Basics/ThemeExample.xaml" CodeType="Xaml" />
            <controls:SourceCodeModel CodeSource="/WPFDevelopers.SamplesCode;component/ExampleViews/Basics/ThemeExample.xaml.cs" CodeType="CSharp" />
        </controls:CodeViewer.SourceCodes>
    </controls:CodeViewer>
</UserControl>
