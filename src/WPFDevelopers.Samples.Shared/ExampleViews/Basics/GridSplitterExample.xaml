<UserControl
    x:Class="WPFDevelopers.Samples.ExampleViews.Basics.GridSplitterExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WPFDevelopers.Samples.Controls"
    Background="{DynamicResource WD.BackgroundBrush}">
    <controls:CodeViewer Header="GridSplitter">
        <StackPanel Margin="20,10">
            <TextBlock Margin="0,10" FontSize="20" Text="Vertical splitter - resize columns" />
            <Grid Height="180">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="60" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="60" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource WD.PrimaryMouseOverBrush}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Left" />
                </Border>
                <GridSplitter
                    Grid.Column="1"
                    Width="5"
                    Margin="2,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Columns"
                    ShowsPreview="True" />
                <Border Grid.Column="2" Background="{DynamicResource WD.PrimaryMouseOverBrush}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Right" />
                </Border>
            </Grid>
            <TextBlock Margin="0,20,0,10" FontSize="20" Text="Horizontal splitter - resize rows" />
            <Grid Height="240">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="40" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="40" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource WD.PrimaryMouseOverBrush}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Top" />
                </Border>
                <GridSplitter
                    Grid.Row="1"
                    Height="5"
                    Margin="0,2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Rows"
                    ShowsPreview="False" />
                <Border Grid.Row="2" Background="{DynamicResource WD.PrimaryMouseOverBrush}">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Bottom" />
                </Border>
            </Grid>
        </StackPanel>
        <controls:CodeViewer.SourceCodes>
            <controls:SourceCodeModel CodeSource="/WPFDevelopers.SamplesCode;component/ExampleViews/Basics/GridSplitterExample.xaml" CodeType="Xaml" />
        </controls:CodeViewer.SourceCodes>
    </controls:CodeViewer>
</UserControl>
