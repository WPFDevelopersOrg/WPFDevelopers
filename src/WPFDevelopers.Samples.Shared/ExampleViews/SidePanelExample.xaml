<UserControl
    x:Class="WPFDevelopers.Samples.ExampleViews.SidePanelExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WPFDevelopers.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFDevelopers.Samples.ExampleViews"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wd="https://github.com/WPFDevelopersOrg/WPFDevelopers"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <controls:CodeViewer Header="{Binding NavigateMenuItem.Name}">
        <TabControl>
            <TabItem Header="Event">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ToggleButton
                        x:Name="SidePanelToggle"
                        Margin="10"
                        HorizontalAlignment="Left"
                        Content="侧边面板"
                        IsChecked="True" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <wd:SidePanel
                            x:Name="EventSidePanel"
                            BorderThickness="0,0,1,0"
                            ExpandedWidth="220"
                            IsExpanded="{Binding ElementName=SidePanelToggle, Path=IsChecked}">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="EventWorkspace" FontSize="18" FontWeight="SemiBold" Text="工作区" />
                                    <Button
                                        x:Name="EventNewTask"
                                        Margin="0,12,0,16"
                                        Click="NewSidePanelTask_Click"
                                        Content="新建任务"
                                        Style="{StaticResource WD.PrimaryButton}" />
                                    <TextBlock FontWeight="SemiBold" Text="最近任务" />
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="SidePanelTaskList" Margin="0,8,0,0">
                                        <TextBlock Margin="0,6" Text="任务 1" />
                                        <TextBlock Margin="0,6" Text="任务 2" />
                                        <TextBlock Margin="0,6" Text="任务 3" />
                                    </StackPanel>
                                </ScrollViewer>
                                <TextBlock Grid.Row="2" Margin="0,12,0,0" Text="账户" />
                            </Grid>
                        </wd:SidePanel>
                        <TextBlock
                            Grid.Column="1"
                            Margin="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="主内容"
                            TextAlignment="Center" />
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="MVVM">
                <Grid DataContext="{Binding ViewModel, RelativeSource={RelativeSource AncestorType={x:Type local:SidePanelExample}}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button
                        x:Name="MvvmToggle"
                        Margin="10"
                        HorizontalAlignment="Left"
                        Command="{Binding ToggleCommand}"
                        Content="侧边面板" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <wd:SidePanel
                            x:Name="MvvmSidePanel"
                            BorderThickness="0,0,1,0"
                            ExpandedWidth="220"
                            IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="MvvmWorkspace" FontSize="18" FontWeight="SemiBold" Text="工作区" />
                                    <Button
                                        x:Name="MvvmNewTask"
                                        Margin="0,12,0,16"
                                        Command="{Binding AddTaskCommand}"
                                        Content="新建任务"
                                        Style="{StaticResource WD.PrimaryButton}" />
                                    <TextBlock FontWeight="SemiBold" Text="最近任务" />
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="MvvmTasks" Margin="0,8,0,0" ItemsSource="{Binding Tasks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,6" Text="{Binding Text}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock Grid.Row="2" Margin="0,12,0,0" Text="账户" />
                            </Grid>
                        </wd:SidePanel>
                        <TextBlock
                            Grid.Column="1"
                            Margin="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="主内容"
                            TextAlignment="Center" />
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="方向">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <wd:Segmented
                        x:Name="DirectionSegmented"
                        Margin="10"
                        HorizontalAlignment="Left"
                        SelectedIndex="0">
                        <wd:SegmentedItem Content="收起" />
                        <wd:SegmentedItem x:Name="LeftSegment" Content="左侧" />
                        <wd:SegmentedItem x:Name="RightSegment" Content="右侧" />
                        <wd:SegmentedItem x:Name="TopSegment" Content="顶部" />
                        <wd:SegmentedItem x:Name="BottomSegment" Content="底部" />
                    </wd:Segmented>
                    <DockPanel Grid.Row="1">
                        <wd:SidePanel
                            Background="{DynamicResource WD.BaseMoveBrush}"
                            BorderBrush="{DynamicResource WD.PrimaryBrush}"
                            BorderThickness="1"
                            Dock="Top"
                            DockPanel.Dock="Top"
                            ExpandedHeight="60"
                            IsExpanded="{Binding IsChecked, ElementName=TopSegment, Mode=OneWay}">
                            <TextBlock Margin="12" Text="顶部" />
                        </wd:SidePanel>
                        <wd:SidePanel
                            Background="{DynamicResource WD.BaseMoveBrush}"
                            BorderBrush="{DynamicResource WD.PrimaryBrush}"
                            BorderThickness="1"
                            Dock="Bottom"
                            DockPanel.Dock="Bottom"
                            ExpandedHeight="60"
                            IsExpanded="{Binding IsChecked, ElementName=BottomSegment, Mode=OneWay}">
                            <TextBlock Margin="12" Text="底部" />
                        </wd:SidePanel>
                        <wd:SidePanel
                            Background="{DynamicResource WD.BaseMoveBrush}"
                            BorderBrush="{DynamicResource WD.PrimaryBrush}"
                            BorderThickness="1"
                            Dock="Left"
                            DockPanel.Dock="Left"
                            ExpandedWidth="120"
                            IsExpanded="{Binding IsChecked, ElementName=LeftSegment, Mode=OneWay}">
                            <TextBlock Margin="12" Text="左侧" />
                        </wd:SidePanel>
                        <wd:SidePanel
                            Background="{DynamicResource WD.BaseMoveBrush}"
                            BorderBrush="{DynamicResource WD.PrimaryBrush}"
                            BorderThickness="1"
                            Dock="Right"
                            DockPanel.Dock="Right"
                            ExpandedWidth="120"
                            IsExpanded="{Binding IsChecked, ElementName=RightSegment, Mode=OneWay}">
                            <TextBlock Margin="12" Text="右侧" />
                        </wd:SidePanel>
                        <Border Background="{DynamicResource WD.BackgroundBrush}">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="主内容" />
                        </Border>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <controls:CodeViewer.SourceCodes>
            <controls:SourceCodeModel CodeSource="/WPFDevelopers.SamplesCode;component/ExampleViews/SidePanelExample.xaml" CodeType="Xaml" />
            <controls:SourceCodeModel CodeSource="/WPFDevelopers.SamplesCode;component/ExampleViews/SidePanelExample.xaml.cs" CodeType="CSharp" />
            <controls:SourceCodeModel
                CodeSource="/WPFDevelopers.SamplesCode;component/ViewModels/SidePanelExampleViewModel.cs"
                CodeType="CSharp"
                Haader="ViewModel" />
        </controls:CodeViewer.SourceCodes>
    </controls:CodeViewer>
</UserControl>
