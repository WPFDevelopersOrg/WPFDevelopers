<UserControl
    x:Class="WPFDevelopers.Samples.ExampleViews.NotifyIconExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WPFDevelopers.Samples.Controls"
    xmlns:wd="https://github.com/WPFDevelopersOrg/WPFDevelopers"
    Loaded="NotifyIconExample_Loaded"
    Unloaded="NotifyIconExample_Unloaded">
    <UserControl.Resources>
        <DataTemplate x:Key="TrayIconTemplate">
            <wd:NotifyIcon
                Title="WPFDevelopers - NotifyIcon 示例"
                Click="NotifyIcon_Click"
                Icon="pack://application:,,,/WPFDevelopers.Samples;component/WPFDevelopers.ico"
                MouseDoubleClick="NotifyIcon_MouseDoubleClick">
                <wd:NotifyIcon.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="BtnNotifyIconMessage_Click" Header="发送托盘消息" />
                        <MenuItem Click="ContextContent_Twink_Click" Header="切换图标闪烁" />
                        <Separator />
                        <MenuItem Click="About_Click" Header="关于本示例" />
                    </ContextMenu>
                </wd:NotifyIcon.ContextMenu>
            </wd:NotifyIcon>
        </DataTemplate>
        <DataTemplate x:Key="TrayPanelTemplate">
            <Border
                Width="240"
                Padding="16"
                Background="{DynamicResource WD.BackgroundBrush}"
                BorderBrush="{DynamicResource WD.BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel wd:PanelHelper.Spacing="12">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="WPFDevelopers" />
                    <TextBlock Text="自定义托盘面板" />
                    <Button
                        Click="BtnNotifyIconMessage_Click"
                        Content="发送托盘消息"
                        Style="{StaticResource WD.SuccessPrimaryButton}" />
                    <Button
                        Click="ContextContent_Twink_Click"
                        Content="切换图标闪烁"
                        Style="{StaticResource WD.PrimaryButton}" />
                    <Button Click="About_Click" Content="关于本示例" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid
            x:Name="TrayIconHost"
            Width="0"
            Height="0" />
        <controls:CodeViewer Header="{Binding NavigateMenuItem.Name}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20" wd:PanelHelper.Spacing="16">
                    <TextBlock
                        FontSize="22"
                        FontWeight="SemiBold"
                        Text="系统托盘 NotifyIcon" />
                    <TextBlock Text="本页只创建一个示例图标，与主窗口图标独立。离开页面会自动移除，重新进入不会累积。" TextWrapping="Wrap" />
                    <GroupBox Header="图标与生命周期">
                        <StackPanel wd:PanelHelper.Spacing="10">
                            <WrapPanel wd:PanelHelper.Spacing="12">
                                <Image
                                    Width="32"
                                    Height="32"
                                    Source="/WPFDevelopers.Samples;component/WPFDevelopers.ico" />
                                <TextBlock
                                    x:Name="IconStatusText"
                                    VerticalAlignment="Center"
                                    Text="示例图标未创建" />
                                <Button
                                    x:Name="ToggleIconButton"
                                    Click="ToggleIcon_Click"
                                    Content="创建示例图标" />
                            </WrapPanel>
                            <TextBlock Text="悬停图标时提示为“WPFDevelopers - NotifyIcon 示例”。可在 Windows 托盘折叠区中找到它。" TextWrapping="Wrap" />
                        </StackPanel>
                    </GroupBox>
                    <StackPanel
                        x:Name="InteractionPanel"
                        wd:PanelHelper.Spacing="16"
                        IsEnabled="False">
                        <GroupBox Header="点击事件与右键菜单">
                            <StackPanel wd:PanelHelper.Spacing="10">
                                <WrapPanel wd:PanelHelper.Spacing="10">
                                    <TextBlock VerticalAlignment="Center" Text="右键显示：" />
                                    <ComboBox
                                        x:Name="MenuMode"
                                        Width="180"
                                        SelectedIndex="0"
                                        SelectionChanged="MenuMode_SelectionChanged">
                                        <ComboBoxItem Content="标准菜单 ContextMenu" />
                                        <ComboBoxItem Content="自定义面板 ContextContent" />
                                    </ComboBox>
                                </WrapPanel>
                                <WrapPanel wd:PanelHelper.Spacing="10">
                                    <TextBlock Text="左键单击：" />
                                    <TextBlock
                                        x:Name="ClickCountText"
                                        FontWeight="Bold"
                                        Text="0" />
                                    <TextBlock Text="双击：" />
                                    <TextBlock
                                        x:Name="DoubleClickCountText"
                                        FontWeight="Bold"
                                        Text="0" />
                                </WrapPanel>
                                <TextBlock Text="在系统托盘中单击或双击示例图标，计数和下方操作反馈会更新。" TextWrapping="Wrap" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="发送托盘消息">
                            <StackPanel wd:PanelHelper.Spacing="10">
                                <TextBox
                                    x:Name="MessageTitle"
                                    wd:ElementHelper.Watermark="通知标题"
                                    MaxLength="63"
                                    Text="WPFDevelopers" />
                                <TextBox
                                    x:Name="MessageContent"
                                    wd:ElementHelper.Watermark="通知内容"
                                    MaxLength="255"
                                    Text="欢迎使用 WPFDevelopers！"
                                    TextWrapping="Wrap" />
                                <WrapPanel wd:PanelHelper.Spacing="10">
                                    <ComboBox
                                        x:Name="MessageType"
                                        Width="140"
                                        SelectedIndex="0">
                                        <ComboBoxItem Content="信息 Info" Tag="{x:Static wd:NotifyIconInfoType.Info}" />
                                        <ComboBoxItem Content="警告 Warning" Tag="{x:Static wd:NotifyIconInfoType.Warning}" />
                                        <ComboBoxItem Content="错误 Error" Tag="{x:Static wd:NotifyIconInfoType.Error}" />
                                        <ComboBoxItem Content="无图标 None" Tag="{x:Static wd:NotifyIconInfoType.None}" />
                                    </ComboBox>
                                    <Button
                                        Click="BtnNotifyIconMessage_Click"
                                        Content="发送托盘消息"
                                        Style="{StaticResource WD.SuccessPrimaryButton}" />
                                </WrapPanel>
                                <TextBlock Text="消息由当前示例图标的 ShowBalloonTips 实例方法发送。Windows 通知设置或勿扰模式可能阻止通知显示。" TextWrapping="Wrap" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="图标闪烁">
                            <StackPanel wd:PanelHelper.Spacing="10">
                                <CheckBox
                                    x:Name="TwinkCheckBox"
                                    Checked="Twink_Changed"
                                    Content="开启图标闪烁（每 500 毫秒切换）"
                                    Unchecked="Twink_Changed" />
                                <TextBlock Text="右键菜单和自定义面板中的“切换图标闪烁”与这里同步。停止后恢复原图标。" TextWrapping="Wrap" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                    <GroupBox Header="操作反馈">
                        <TextBlock
                            x:Name="FeedbackText"
                            Text="等待操作。"
                            TextWrapping="Wrap" />
                    </GroupBox>
                    <TextBlock Text="生命周期：Loaded 创建实例，Unloaded 调用 Dispose；不在切换选项卡时销毁图标。源码见 CodeViewer 中的 XAML / CSharp。" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
            <controls:CodeViewer.SourceCodes>
                <controls:SourceCodeModel CodeSource="/WPFDevelopers.SamplesCode;component/ExampleViews/NotifyIconExample.xaml" CodeType="Xaml" />
                <controls:SourceCodeModel CodeSource="/WPFDevelopers.SamplesCode;component/ExampleViews/NotifyIconExample.xaml.cs" CodeType="CSharp" />
            </controls:CodeViewer.SourceCodes>
        </controls:CodeViewer>
    </Grid>
</UserControl>
