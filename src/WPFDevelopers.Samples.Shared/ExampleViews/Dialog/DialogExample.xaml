<UserControl
    x:Class="WPFDevelopers.Samples.ExampleViews.DialogExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WPFDevelopers.Samples.Controls"
    xmlns:vm="clr-namespace:WPFDevelopers.Samples.ViewModels"
    xmlns:wd="https://github.com/WPFDevelopersOrg/WPFDevelopers"
    x:Name="DialogExampleView">
    <UserControl.Resources>
        <vm:DialogExampleVM x:Key="DialogViewModel" />
    </UserControl.Resources>
    <controls:CodeViewer Header="{Binding NavigateMenuItem.Name}">
        <TabControl Margin="0,10">
            <TabItem Header="C#">
                <StackPanel
                    Margin="0,24"
                    HorizontalAlignment="Center"
                    wd:PanelHelper.Spacing="5">
                    <Button
                        Padding="16,8"
                        HorizontalAlignment="Left"
                        Click="OpenUserControl_Click"
                        Content="Dialog"
                        Style="{DynamicResource WD.PrimaryButton}" />
                    <TextBlock
                        x:Name="ResultText"
                        Margin="0,20,0,0"
                        TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>
            <TabItem Header="MVVM">
                <StackPanel
                    Margin="0,24"
                    HorizontalAlignment="Center"
                    wd:PanelHelper.Spacing="5"
                    DataContext="{StaticResource DialogViewModel}">
                    <Button
                        Padding="16,8"
                        HorizontalAlignment="Left"
                        Command="{Binding OpenDialogCommand}"
                        CommandParameter="{Binding ElementName=DialogExampleView}"
                        Content="Open MVVM dialog"
                        Style="{DynamicResource WD.PrimaryButton}" />
                    <TextBlock
                        Margin="0,20,0,0"
                        Text="{Binding ResultText}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>
        </TabControl>
        <controls:CodeViewer.SourceCodes>
            <controls:SourceCodeModel
                CodeSource="/WPFDevelopers.SamplesCode;component/ExampleViews/Dialog/DialogExample.xaml"
                CodeType="Xaml"
                Haader="Xaml" />
            <controls:SourceCodeModel
                CodeSource="/WPFDevelopers.SamplesCode;component/ExampleViews/Dialog/DialogExample.xaml.cs"
                CodeType="CSharp"
                Haader="C#" />
            <controls:SourceCodeModel
                CodeSource="/WPFDevelopers.SamplesCode;component/ViewModels/DialogExampleVM.cs"
                CodeType="CSharp"
                Haader="VM" />
            <controls:SourceCodeModel
                CodeSource="/WPFDevelopers.SamplesCode;component/ExampleViews/Dialog/DialogUserControl.xaml"
                CodeType="Xaml"
                Haader="DialogUserControl" />
        </controls:CodeViewer.SourceCodes>
    </controls:CodeViewer>
</UserControl>
