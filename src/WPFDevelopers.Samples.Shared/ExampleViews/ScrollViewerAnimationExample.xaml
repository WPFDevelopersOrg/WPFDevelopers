<UserControl
    x:Class="WPFDevelopers.Samples.ExampleViews.ScrollViewerAnimationExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WPFDevelopers.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFDevelopers.Samples.ExampleViews"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:WPFDevelopers.Samples.ViewModels"
    xmlns:wd="https://github.com/WPFDevelopersOrg/WPFDevelopers"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <controls:CodeViewer Header="{Binding NavigateMenuItem.Name}">
        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Margin="10" Text="ScrollViewer" />
                <ScrollViewer
                    Width="200"
                    MaxHeight="300"
                    wd:ScrollViewerBehavior.IsBackToTopEnabled="True">
                    <ItemsControl ItemsSource="{Binding NavigateMenuModelList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Background="{StaticResource WD.SuccessBrush}"
                                    BorderBrush="{StaticResource WD.BackgroundBrush}"
                                    BorderThickness="0,0,0,.3">
                                    <TextBlock
                                        Padding="10"
                                        FontSize="{StaticResource WD.PrimaryFontSize}"
                                        Foreground="{DynamicResource WD.PrimaryTextBrush}"
                                        Text="{Binding Name}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>


            <StackPanel Margin="10,0">
                <TextBlock Margin="10" Text="Horizontal ScrollViewer" />
                <TextBlock Margin="10,0,10,8" Text="Use the mouse wheel or touchpad to scroll horizontally." />
                <ScrollViewer
                    Width="200"
                    Height="90"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <Border
                            Width="140"
                            Margin="0,0,8,0"
                            Background="{StaticResource WD.SuccessBrush}"
                            Padding="12">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource WD.PrimaryTextBrush}"
                                Text="Item 1" />
                        </Border>
                        <Border
                            Width="140"
                            Margin="0,0,8,0"
                            Background="{StaticResource WD.DangerBrush}"
                            Padding="12">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource WD.PrimaryTextBrush}"
                                Text="Item 2" />
                        </Border>
                        <Border
                            Width="140"
                            Background="{StaticResource WD.SuccessBrush}"
                            Padding="12">
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource WD.PrimaryTextBrush}"
                                Text="Item 3" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>

            <StackPanel Margin="10,0">
                <TextBlock Margin="10" Text="wd:WDScrollViewer" />
                <wd:WDScrollViewer
                    Width="200"
                    MaxHeight="300"
                    IsScrollAnimation="True"
                    wd:ScrollViewerBehavior.IsBackToTopEnabled="True">
                    <ItemsControl ItemsSource="{Binding NavigateMenuModelList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Background="{StaticResource WD.DangerBrush}"
                                    BorderBrush="{StaticResource WD.BackgroundBrush}"
                                    BorderThickness="0,0,0,.3">
                                    <TextBlock
                                        Padding="10"
                                        FontSize="{StaticResource WD.PrimaryFontSize}"
                                        Foreground="{DynamicResource WD.PrimaryTextBrush}"
                                        Text="{Binding Name}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </wd:WDScrollViewer>
            </StackPanel>
        </WrapPanel>
        <controls:CodeViewer.SourceCodes>
            <controls:SourceCodeModel CodeSource="/WPFDevelopers.SamplesCode;component/ExampleViews/ScrollViewerAnimationExample.xaml" CodeType="Xaml" />
            <controls:SourceCodeModel CodeSource="/WPFDevelopers.SamplesCode;component/ExampleViews/ScrollViewerAnimationExample.xaml.cs" CodeType="CSharp" />
        </controls:CodeViewer.SourceCodes>
    </controls:CodeViewer>
</UserControl>
