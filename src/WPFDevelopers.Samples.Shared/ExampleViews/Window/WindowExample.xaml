<UserControl
    x:Class="WPFDevelopers.Samples.ExampleViews.WindowExample"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WPFDevelopers.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFDevelopers.Samples.ExampleViews"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wd="https://github.com/WPFDevelopersOrg/WPFDevelopers"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <controls:CodeViewer Header="{Binding NavigateMenuItem.Name}">
        <Grid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    Margin="0,0,0,16"
                    HorizontalAlignment="Center"
                    Text="Normal / HighTitleBar: TitleBarLayout + Light / Dark" />
                <UniformGrid
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    wd:PanelHelper.Spacing="10"
                    Rows="2">
                    <TextBlock VerticalAlignment="Center" Text="TitleBarMode:" />
                    <Button
                        wd:ElementHelper.CornerRadius="3"
                        Click="BtnNormal_Click"
                        Content="Normal"
                        Style="{DynamicResource WD.PrimaryButton}" />
                    <Button
                        wd:ElementHelper.CornerRadius="3"
                        Click="BtnHighTitleBar_Click"
                        Content="HighTitleBar"
                        Style="{DynamicResource WD.SuccessDefaultButton}" />
                    <TextBlock VerticalAlignment="Center" Text="HighTitleBar &amp; NoChrome = True:" />
                    <Button
                        wd:ElementHelper.CornerRadius="3"
                        Click="Button_Click"
                        Content="ToolWindow"
                        Style="{DynamicResource WD.PrimaryButton}" />
                    <Button
                        wd:ElementHelper.CornerRadius="3"
                        Click="ButtonNone_Click"
                        Content="NoneTitleBarWindow"
                        Style="{DynamicResource WD.DangerPrimaryButton}" />
                </UniformGrid>
            </StackPanel>
        </Grid>
        <controls:CodeViewer.SourceCodes>
            <controls:SourceCodeModel CodeSource="/WPFDevelopers.SamplesCode;component/ExampleViews/Window/NormalWindow.xaml" CodeType="Xaml" Haader="Normal Xaml" />
            <controls:SourceCodeModel CodeSource="/WPFDevelopers.SamplesCode;component/ExampleViews/Window/NormalWindow.xaml.cs" CodeType="CSharp" Haader="Normal CSharp" />
            <controls:SourceCodeModel CodeSource="/WPFDevelopers.SamplesCode;component/ExampleViews/Window/HighTitleBarWindow.xaml" CodeType="Xaml" Haader="HighTitleBar Xaml" />
            <controls:SourceCodeModel CodeSource="/WPFDevelopers.SamplesCode;component/ExampleViews/Window/HighTitleBarWindow.xaml.cs" CodeType="CSharp" Haader="HighTitleBar CSharp" />
        </controls:CodeViewer.SourceCodes>
    </controls:CodeViewer>
</UserControl>
