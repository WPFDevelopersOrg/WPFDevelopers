<UserControl
    x:Class="WPFDevelopers.Samples.ExampleViews.UsageColor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WPFDevelopers.Samples.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFDevelopers.Samples.ExampleViews"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wd="https://github.com/WPFDevelopersOrg/WPFDevelopers"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style TargetType="TextBox">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="Foreground" Value="{DynamicResource WD.BackgroundBrush}" />
            <Setter Property="IsReadOnly" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="BorderBrush" Value="#66000000" />
                    <Setter Property="Background" Value="#10FFFFFF" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="BorderBrush" Value="#CC409EFF" />
                    <Setter Property="Background" Value="#16FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <controls:CodeViewer Header="{Binding NavigateMenuItem.Name}">
        <ScrollViewer HorizontalScrollBarVisibility="Auto">
            <ItemsControl
                Width="760"
                VerticalAlignment="Center"
                ItemsSource="{Binding Colors}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8">
                            <Border
                                Width="176"
                                Height="96"
                                Background="{Binding Brush}"
                                CornerRadius="6,6,0,0">
                                <wd:SmallPanel>
                                    <StackPanel Margin="8,8,8,8" VerticalAlignment="Center">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="{StaticResource WD.TitleFontSize}"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding ForegroundBrush, Mode=OneWay}"
                                            Text="{Binding Name}" />
                                        <TextBox
                                            Margin="0,4,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="19"
                                            FontWeight="Bold"
                                            Foreground="{Binding ForegroundBrush, Mode=OneWay}"
                                            Text="{Binding ColorCode, Mode=OneWay}" />
                                        <TextBox
                                            Margin="0,3,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{Binding ForegroundBrush, Mode=OneWay}"
                                            Opacity="0.95"
                                            Text="{Binding BrushKey, Mode=OneWay}" />
                                    </StackPanel>
                                    <Button
                                        Width="24"
                                        Height="24"
                                        Margin="0,6,6,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Click="BtnPrimary_Click"
                                        Style="{StaticResource WD.NormalButton}"
                                        Tag="{Binding BrushKey}"
                                        ToolTip="Copy Key">
                                        <wd:PathIcon
                                            Width="10"
                                            Height="10"
                                            Foreground="{DynamicResource WD.ChartFillBrush}"
                                            Kind="Copy" />
                                    </Button>
                                </wd:SmallPanel>
                            </Border>
                            <Border
                                Width="176"
                                Height="64"
                                Background="{Binding MouseOverBrush}"
                                BorderBrush="{Binding MouseOverBorderBrush, Mode=OneWay}"
                                BorderThickness="{Binding MouseOverBorderThickness, Mode=OneWay}"
                                CornerRadius="0,0,6,6">
                                <wd:SmallPanel>
                                    <StackPanel
                                        Margin="8,6,8,6"
                                        VerticalAlignment="Center"
                                        Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding MouseOverForegroundBrush, Mode=OneWay}"
                                                Opacity="0.85"
                                                Text="{Binding MouseOver, Mode=OneWay}"
                                                Visibility="{Binding ShowMouseOverSection, Converter={StaticResource WD.Bool2VisibilityConverter}}" />
                                            <TextBox
                                                Margin="4,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                FontWeight="Bold"
                                                Foreground="{Binding MouseOverForegroundBrush, Mode=OneWay}"
                                                Opacity="0.95"
                                                Text="{Binding MouseOverColorCode, Mode=OneWay}"
                                                Visibility="{Binding ShowMouseOverSection, Converter={StaticResource WD.Bool2VisibilityConverter}}" />
                                        </StackPanel>
                                        <TextBox
                                            Margin="0,2,0,0"
                                            FontSize="11"
                                            Foreground="{Binding MouseOverForegroundBrush, Mode=OneWay}"
                                            Opacity="0.85"
                                            Text="{Binding MouseOverKey, Mode=OneWay}"
                                            Visibility="{Binding HasMouseOverKey, Converter={StaticResource WD.Bool2VisibilityConverter}}" />
                                    </StackPanel>
                                    <Button
                                        Width="24"
                                        Height="24"
                                        Margin="0,0,6,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Click="BtnMouseOver_Click"
                                        Style="{StaticResource WD.NormalButton}"
                                        Tag="{Binding MouseOverKey}"
                                        ToolTip="Copy Key"
                                        Visibility="{Binding HasMouseOverKey, Converter={StaticResource WD.Bool2VisibilityConverter}}">
                                        <wd:PathIcon
                                            Width="10"
                                            Height="6"
                                            Kind="Copy" />
                                    </Button>
                                </wd:SmallPanel>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </controls:CodeViewer>
</UserControl>
