<UserControl
    x:Class="WPFDevelopers.Samples.Controls.ThemeSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WPFDevelopers.Samples.Controls"
    xmlns:resx="clr-namespace:WPFDevelopers;assembly=WPFDevelopers"
    xmlns:wd="https://github.com/WPFDevelopersOrg/WPFDevelopers">
    <StackPanel wd:PanelHelper.Spacing="12">
        <TextBlock
            x:Name="PersonalizationLabel"
            FontSize="18"
            FontWeight="SemiBold"
            Text="个性化" />
        <TextBlock x:Name="ThemeColorLabel" Text="主题色" />
        <controls:Theme HorizontalAlignment="Left" />
        <wd:Segmented
            x:Name="ThemeSelector"
            HorizontalAlignment="Left"
            wd:ElementHelper.CornerRadius="18"
            ItemClick="ThemeSelector_ItemClick">
            <wd:SegmentedItem Padding="14,8" ToolTip="{Binding [FollowSystem], Source={x:Static resx:LanguageManager.Instance}}">
                <Path Width="18" Height="18" Data="{DynamicResource WD.SystemThemeGeometry}" Stroke="{DynamicResource WD.PrimaryTextBrush}" StrokeThickness="1.1" Stretch="Uniform" />
            </wd:SegmentedItem>
            <wd:SegmentedItem Padding="14,8" ToolTip="{Binding [LightMode], Source={x:Static resx:LanguageManager.Instance}}">
                <wd:PathIcon
                    Width="18"
                    Height="18"
                    Kind="Sun" />
            </wd:SegmentedItem>
            <wd:SegmentedItem Padding="14,8" ToolTip="{Binding [DarkMode], Source={x:Static resx:LanguageManager.Instance}}">
                <Path
                    Width="18"
                    Height="18"
                    Data="{DynamicResource WD.MoonGeometry}"
                    Stroke="{DynamicResource WD.PrimaryTextBrush}"
                    StrokeThickness="1.1"
                    StrokeLineJoin="Round"
                    Stretch="Uniform" />
            </wd:SegmentedItem>
        </wd:Segmented>
        <TextBlock x:Name="LanguageLabel" Text="Languages" />
        <ComboBox
            x:Name="LanguageSelector"
            MinWidth="140"
            HorizontalAlignment="Left"
            SelectionChanged="LanguageSelector_SelectionChanged">
            <ComboBoxItem Tag="zh-CN">中文</ComboBoxItem>
            <ComboBoxItem Tag="en-US">English</ComboBoxItem>
            <ComboBoxItem Tag="ko-KR">한국어</ComboBoxItem>
        </ComboBox>
    </StackPanel>
</UserControl>
