<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WPFDevelopers.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Basic/ControlBasic.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style
        x:Key="WD.TimelineItem"
        BasedOn="{StaticResource WD.ControlBasicStyle}"
        TargetType="{x:Type controls:TimelineItem}">
        <Setter Property="DotBrush" Value="{DynamicResource WD.PrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WD.PrimaryTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TimelineItem}">
                    <controls:TimelineItemPanel x:Name="PART_Layout">
                        <ContentPresenter
                            Content="{TemplateBinding Label}"
                            ContentTemplate="{TemplateBinding LabelTemplate}"
                            TextElement.Foreground="{DynamicResource WD.RegularTextBrush}" />
                        <Grid VerticalAlignment="Top">
                            <Ellipse
                                x:Name="PART_DefaultDot"
                                Width="10"
                                Height="10"
                                Margin="0,4"
                                Stroke="{TemplateBinding DotBrush}"
                                StrokeThickness="2" />
                            <Path
                                x:Name="PART_LoadingDot"
                                Width="14"
                                Height="14"
                                Margin="0,2"
                                Data="{StaticResource WD.SemicircleGeometry}"
                                RenderTransformOrigin="0.5,0.5"
                                Stroke="{TemplateBinding DotBrush}"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="2"
                                Visibility="Collapsed">
                                <Path.RenderTransform>
                                    <RotateTransform />
                                </Path.RenderTransform>
                            </Path>
                            <ContentPresenter
                                x:Name="PART_CustomDot"
                                Content="{TemplateBinding Dot}"
                                ContentTemplate="{TemplateBinding DotTemplate}"
                                TextElement.Foreground="{TemplateBinding DotBrush}" />
                        </Grid>
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </controls:TimelineItemPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_DefaultDot" Property="Margin" Value="4,0" />
                            <Setter TargetName="PART_LoadingDot" Property="Margin" Value="2,0" />
                        </Trigger>
                        <Trigger Property="IsLoading" Value="True">
                            <Setter TargetName="PART_DefaultDot" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_LoadingDot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_CustomDot" Property="Visibility" Value="Collapsed" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="LoadingStoryboard">
                                    <Storyboard>
                                        <DoubleAnimation
                                            RepeatBehavior="Forever"
                                            Storyboard.TargetName="PART_LoadingDot"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                            From="0"
                                            To="360"
                                            Duration="0:0:1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="LoadingStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Dot" Value="{x:Null}" />
                                <Condition Property="DotTemplate" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_CustomDot" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <Trigger SourceName="PART_CustomDot" Property="Visibility" Value="Visible">
                            <Setter TargetName="PART_DefaultDot" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource WD.TimelineItem}" TargetType="{x:Type controls:TimelineItem}" />
    <Style
        x:Key="WD.Timeline"
        BasedOn="{StaticResource WD.ControlBasicStyle}"
        TargetType="{x:Type controls:Timeline}">
        <Setter Property="LineBrush" Value="{DynamicResource WD.BaseBrush}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource WD.TimelineItem}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <controls:TimelinePanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Timeline}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer
                            x:Name="PART_ScrollViewer"
                            CanContentScroll="False"
                            Focusable="False"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style BasedOn="{StaticResource WD.Timeline}" TargetType="{x:Type controls:Timeline}" />
</ResourceDictionary>
