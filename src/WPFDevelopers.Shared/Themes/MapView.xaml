<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WPFDevelopers.Controls"
    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <SolidColorBrush
        x:Key="WD.MapPinShadowBrush"
        po:Freeze="True"
        Color="#24000000" />

    <LinearGradientBrush x:Key="WD.MapPinFillBrush" po:Freeze="True" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Offset="0" Color="#FF7373" />
        <GradientStop Offset="1" Color="#D93838" />
    </LinearGradientBrush>

    <SolidColorBrush
        x:Key="WD.MapPinStrokeBrush"
        po:Freeze="True"
        Color="#9F2020" />
    <SolidColorBrush
        x:Key="WD.MapPinInnerFillBrush"
        po:Freeze="True"
        Color="White" />
    <SolidColorBrush
        x:Key="WD.MapPinInnerStrokeBrush"
        po:Freeze="True"
        Color="#B52B2B" />
    <SolidColorBrush
        x:Key="WD.MapPinHighlightBrush"
        po:Freeze="True"
        Color="#70FFFFFF" />

    <SolidColorBrush
        x:Key="WD.MapClusterShadowBrush"
        po:Freeze="True"
        Color="#2A000000" />
    <SolidColorBrush
        x:Key="WD.MapClusterHaloBrush"
        po:Freeze="True"
        Color="#55E74A4A" />
    <SolidColorBrush
        x:Key="WD.MapClusterStrokeBrush"
        po:Freeze="True"
        Color="White" />
    <SolidColorBrush
        x:Key="WD.MapClusterHighlightBrush"
        po:Freeze="True"
        Color="#66FFFFFF" />
    <SolidColorBrush
        x:Key="WD.MapClusterBodyBrush"
        po:Freeze="True"
        Color="#E74A4A" />
    <SolidColorBrush
        x:Key="WD.MapClusterTextBrush"
        po:Freeze="True"
        Color="White" />

    <Style x:Key="WD.MapPinStyle" TargetType="{x:Type controls:MapPin}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="40" />
        <Setter Property="RenderTransformOrigin" Value="0.5,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:MapPin}">
                    <Viewbox
                        IsHitTestVisible="False"
                        RenderTransformOrigin="0.5,1"
                        Stretch="Fill">
                        <Canvas Width="30" Height="40">
                            <Ellipse
                                Canvas.Left="9"
                                Canvas.Top="34"
                                Width="12"
                                Height="3"
                                Fill="{DynamicResource WD.MapPinShadowBrush}"
                                IsHitTestVisible="False" />

                            <Path
                                Canvas.Left="5"
                                Canvas.Top="3"
                                Width="30"
                                Height="40"
                                Data="{DynamicResource WD.MapPinGeometry}"
                                Fill="{DynamicResource WD.MapPinFillBrush}"
                                Stroke="{DynamicResource WD.MapPinStrokeBrush}"
                                StrokeThickness="1.1" />

                            <Ellipse
                                Canvas.Left="10.25"
                                Canvas.Top="11"
                                Width="9.5"
                                Height="9.5"
                                Fill="{DynamicResource WD.MapPinInnerFillBrush}"
                                Stroke="{DynamicResource WD.MapPinInnerStrokeBrush}"
                                StrokeThickness="0.9" />

                            <Ellipse
                                Canvas.Left="10.9"
                                Canvas.Top="8"
                                Width="5.5"
                                Height="2.0"
                                Fill="{DynamicResource WD.MapPinHighlightBrush}">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-18" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsSelected" Value="False">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WD.MapClusterStyle" TargetType="{x:Type controls:MapCluster}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:MapCluster}">
                    <Viewbox IsHitTestVisible="False" Stretch="Fill">
                        <Grid Width="60" Height="60">
                            <Ellipse
                                Width="52"
                                Height="52"
                                Margin="0,0,0,1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Fill="{DynamicResource WD.MapClusterShadowBrush}" />

                            <Ellipse
                                Width="60"
                                Height="60"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="{DynamicResource WD.MapClusterHaloBrush}" />

                            <Ellipse
                                Width="44"
                                Height="44"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="{TemplateBinding ClusterFill}"
                                Stroke="{DynamicResource WD.MapClusterStrokeBrush}"
                                StrokeThickness="1.6" />

                            <Ellipse
                                Width="34"
                                Height="10"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Fill="{DynamicResource WD.MapClusterHighlightBrush}"
                                RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-14" />
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="{TemplateBinding ClusterTextBrush}"
                                Text="{TemplateBinding CountText}" />
                        </Grid>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource WD.MapPinStyle}" TargetType="{x:Type controls:MapPin}" />
    <Style BasedOn="{StaticResource WD.MapClusterStyle}" TargetType="{x:Type controls:MapCluster}" />
</ResourceDictionary>
