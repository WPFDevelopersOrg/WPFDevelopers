<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WPFDevelopers.Controls"
    xmlns:converts="clr-namespace:WPFDevelopers.Converts"
    xmlns:helpers="clr-namespace:WPFDevelopers.Helpers">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Basic/ControlBasic.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style
        x:Key="WD.SwitchButton"
        BasedOn="{StaticResource WD.ControlBasicStyle}"
        TargetType="{x:Type controls:SwitchButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{DynamicResource WD.RegularTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="{StaticResource WD.Padding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SwitchButton}">
                    <controls:SmallPanel Background="Transparent">
                        <Border
                            Name="PART_Border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding Path=(helpers:ElementHelper.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                            Opacity=".4"
                            SnapsToDevicePixels="True"
                            Visibility="Collapsed" />
                        <ContentPresenter
                            x:Name="PART_UncheckedContent"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding UncheckedContent}" />
                        <ContentPresenter
                            x:Name="PART_CheckedContent"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding CheckedContent}"
                            Visibility="Collapsed" />
                    </controls:SmallPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_UncheckedContent" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_CheckedContent" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Border" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <converts:HalfValueConverter x:Key="WD.DiagonalSwitchButton.HalfValueConverter" />
    <CubicEase x:Key="WD.DiagonalSwitchButton.Easing" EasingMode="EaseInOut" />
    <ControlTemplate x:Key="WD.DiagonalSwitchButton.ContentTemplate" TargetType="{x:Type ContentControl}">
        <ContentPresenter
            Content="{TemplateBinding Content}"
            ContentStringFormat="{TemplateBinding ContentStringFormat}"
            ContentTemplate="{TemplateBinding ContentTemplate}"
            TextElement.Foreground="{TemplateBinding Foreground}" />
    </ControlTemplate>

    <Style
        x:Key="WD.DiagonalSwitchButton"
        BasedOn="{StaticResource WD.ControlBasicStyle}"
        TargetType="{x:Type controls:SwitchButton}">
        <Setter Property="Padding" Value="{StaticResource WD.Padding}" />
        <Setter Property="Background" Value="{DynamicResource WD.BaseBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WD.PrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SwitchButton}">
                    <controls:WDBorder
                        x:Name="PART_ClipBorder"
                        Margin="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource WD.DiagonalSwitchButton.HalfValueConverter}}">
                        <Grid x:Name="PART_Layout" Clip="{Binding ContentClip, ElementName=PART_ClipBorder}">
                            <Canvas>
                                <Viewbox
                                    Width="{Binding ActualWidth, ElementName=PART_Layout}"
                                    Height="{Binding ActualHeight, ElementName=PART_Layout}"
                                    Stretch="Fill">
                                    <Canvas Width="180" Height="100">
                                        <Path x:Name="PART_Shape" Fill="{TemplateBinding Foreground}">
                                            <Path.Data>
                                                <PathGeometry>
                                                    <PathFigure
                                                        x:Name="PART_Figure"
                                                        IsClosed="True"
                                                        StartPoint="0,0">
                                                        <LineSegment x:Name="PART_Top" Point="65,0" />
                                                        <LineSegment x:Name="PART_Bottom" Point="115,100" />
                                                        <LineSegment x:Name="PART_End" Point="0,100" />
                                                    </PathFigure>
                                                </PathGeometry>
                                            </Path.Data>
                                        </Path>
                                    </Canvas>
                                </Viewbox>
                            </Canvas>
                            <Grid IsHitTestVisible="False">
                                <Grid.Resources>
                                    <Style TargetType="{x:Type Path}">
                                        <Setter Property="Fill" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                                    </Style>
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentControl
                                    x:Name="PART_UncheckedContent"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding UncheckedContent}"
                                    Focusable="False"
                                    Foreground="White"
                                    Template="{StaticResource WD.DiagonalSwitchButton.ContentTemplate}" />
                                <ContentControl
                                    x:Name="PART_CheckedContent"
                                    Grid.Column="1"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding CheckedContent}"
                                    Focusable="False"
                                    Foreground="{DynamicResource WD.PrimaryTextBrush}"
                                    Template="{StaticResource WD.DiagonalSwitchButton.ContentTemplate}" />
                            </Grid>
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="Checked">
                                        <Storyboard>
                                            <PointAnimation
                                                EasingFunction="{StaticResource WD.DiagonalSwitchButton.Easing}"
                                                Storyboard.TargetName="PART_Figure"
                                                Storyboard.TargetProperty="StartPoint"
                                                To="65,0"
                                                Duration="0:0:0.25" />
                                            <PointAnimation
                                                EasingFunction="{StaticResource WD.DiagonalSwitchButton.Easing}"
                                                Storyboard.TargetName="PART_Top"
                                                Storyboard.TargetProperty="Point"
                                                To="180,0"
                                                Duration="0:0:0.25" />
                                            <PointAnimation
                                                EasingFunction="{StaticResource WD.DiagonalSwitchButton.Easing}"
                                                Storyboard.TargetName="PART_Bottom"
                                                Storyboard.TargetProperty="Point"
                                                To="180,100"
                                                Duration="0:0:0.25" />
                                            <PointAnimation
                                                EasingFunction="{StaticResource WD.DiagonalSwitchButton.Easing}"
                                                Storyboard.TargetName="PART_End"
                                                Storyboard.TargetProperty="Point"
                                                To="115,100"
                                                Duration="0:0:0.25" />
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition To="Unchecked">
                                        <Storyboard>
                                            <PointAnimation
                                                EasingFunction="{StaticResource WD.DiagonalSwitchButton.Easing}"
                                                Storyboard.TargetName="PART_Figure"
                                                Storyboard.TargetProperty="StartPoint"
                                                To="0,0"
                                                Duration="0:0:0.25" />
                                            <PointAnimation
                                                EasingFunction="{StaticResource WD.DiagonalSwitchButton.Easing}"
                                                Storyboard.TargetName="PART_Top"
                                                Storyboard.TargetProperty="Point"
                                                To="65,0"
                                                Duration="0:0:0.25" />
                                            <PointAnimation
                                                EasingFunction="{StaticResource WD.DiagonalSwitchButton.Easing}"
                                                Storyboard.TargetName="PART_Bottom"
                                                Storyboard.TargetProperty="Point"
                                                To="115,100"
                                                Duration="0:0:0.25" />
                                            <PointAnimation
                                                EasingFunction="{StaticResource WD.DiagonalSwitchButton.Easing}"
                                                Storyboard.TargetName="PART_End"
                                                Storyboard.TargetProperty="Point"
                                                To="0,100"
                                                Duration="0:0:0.25" />
                                        </Storyboard>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <PointAnimation
                                            Storyboard.TargetName="PART_Figure"
                                            Storyboard.TargetProperty="StartPoint"
                                            To="0,0"
                                            Duration="0" />
                                        <PointAnimation
                                            Storyboard.TargetName="PART_Top"
                                            Storyboard.TargetProperty="Point"
                                            To="65,0"
                                            Duration="0" />
                                        <PointAnimation
                                            Storyboard.TargetName="PART_Bottom"
                                            Storyboard.TargetProperty="Point"
                                            To="115,100"
                                            Duration="0" />
                                        <PointAnimation
                                            Storyboard.TargetName="PART_End"
                                            Storyboard.TargetProperty="Point"
                                            To="0,100"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <PointAnimation
                                            Storyboard.TargetName="PART_Figure"
                                            Storyboard.TargetProperty="StartPoint"
                                            To="65,0"
                                            Duration="0" />
                                        <PointAnimation
                                            Storyboard.TargetName="PART_Top"
                                            Storyboard.TargetProperty="Point"
                                            To="180,0"
                                            Duration="0" />
                                        <PointAnimation
                                            Storyboard.TargetName="PART_Bottom"
                                            Storyboard.TargetProperty="Point"
                                            To="180,100"
                                            Duration="0" />
                                        <PointAnimation
                                            Storyboard.TargetName="PART_End"
                                            Storyboard.TargetProperty="Point"
                                            To="115,100"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Indeterminate">
                                    <Storyboard>
                                        <PointAnimation
                                            Storyboard.TargetName="PART_Figure"
                                            Storyboard.TargetProperty="StartPoint"
                                            To="0,0"
                                            Duration="0" />
                                        <PointAnimation
                                            Storyboard.TargetName="PART_Top"
                                            Storyboard.TargetProperty="Point"
                                            To="65,0"
                                            Duration="0" />
                                        <PointAnimation
                                            Storyboard.TargetName="PART_Bottom"
                                            Storyboard.TargetProperty="Point"
                                            To="115,100"
                                            Duration="0" />
                                        <PointAnimation
                                            Storyboard.TargetName="PART_End"
                                            Storyboard.TargetProperty="Point"
                                            To="0,100"
                                            Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </controls:WDBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_UncheckedContent" Property="Foreground" Value="{DynamicResource WD.PrimaryTextBrush}" />
                            <Setter TargetName="PART_CheckedContent" Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource WD.SwitchButton}" TargetType="{x:Type controls:SwitchButton}" />
</ResourceDictionary>
