<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net40;netstandard2.0</TargetFrameworks>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\OutPut\WPFDevelopers.BuildTasks\</OutputPath>
    <AssemblyName>WPFDevelopers.BuildTasks</AssemblyName>
    <RootNamespace>WPFDevelopers.BuildTasks</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.4" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.11.4" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net40'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net40" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="Microsoft.Build.Framework">
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Build.Utilities.v4.0">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
